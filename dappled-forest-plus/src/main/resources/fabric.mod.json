{
	"schemaVersion": 1,
	"id": "dappledforest",
	"version": "${version}",
	"name": "Dappled Forest Plus",
	"description": "Everything for the Dappled Forest in one mod: Poplar Arrows that bury your screen in autumn leaves, the leaf-covered Dappled Skeleton, the rideable Dappled Fox, the fetching Acorn Squirrel, trap-ready leaf piles, leaf tornadoes on windy days and the ultra-rare Sour Candy Apple.",
	"authors": [
		"Conor"
	],
	"license": "MIT",
	"icon": "assets/dappledforest/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.conor.dappledforest.arrow.PoplarArrowMod",
			"com.conor.dappledforest.apple.SourCandyApple",
			"com.conor.dappledforest.leafpiles.DappledLeafPiles",
			"com.conor.dappledforest.fox.DappledFoxMod",
			"com.conor.dappledforest.squirrel.SquirrelMod",
			"com.conor.dappledforest.tornado.TornadoMod",
			"com.conor.dappledforest.DappledForestPlus"
		],
		"client": [
			"com.conor.dappledforest.arrow.client.PoplarArrowClient",
			"com.conor.dappledforest.fox.client.DappledFoxClient",
			"com.conor.dappledforest.squirrel.client.SquirrelClient",
			"com.conor.dappledforest.tornado.client.TornadoClient"
		]
	},
	"mixins": [
		"dappledforest.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}