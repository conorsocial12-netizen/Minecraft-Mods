{
  "schemaVersion": 1,
  "id": "skinglow",
  "version": "${version}",
  "name": "Skin Glow",
  "description": "Adds a subtle, adjustable outline to player skins (and optionally mobs) so they stand out. Open the menu with /skinglow or from Mod Menu. Client-side only.",
  "authors": ["Conor"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.skinglow.SkinGlowClient"],
    "modmenu": ["com.skinglow.SkinGlowModMenu"]
  },
  "mixins": [
    { "config": "skinglow.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
